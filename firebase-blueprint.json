{
  "entities": {
    "users": {
      "title": "User",
      "description": "Registered user accounts and credentials",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "name": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "is_admin": { "type": "boolean" },
        "avatar_color": { "type": "string" }
      },
      "required": ["id", "name", "username"]
    },
    "projects": {
      "title": "Project",
      "description": "Projects and workspaces managed by teams",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "name": { "type": "string" },
        "key": { "type": "string" },
        "description": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "name", "key"]
    },
    "members": {
      "title": "ProjectMember",
      "description": "User project memberships and assigned roles",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "project_id": { "type": "number" },
        "user_id": { "type": "number" },
        "role": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "project_id", "user_id", "role"]
    },
    "columns": {
      "title": "BoardColumn",
      "description": "Kanban / Scrum workflow columns",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "project_id": { "type": "number" },
        "name": { "type": "string" },
        "position": { "type": "number" },
        "color": { "type": "string" },
        "is_done_column": { "type": "boolean" }
      },
      "required": ["id", "project_id", "name", "position"]
    },
    "tasks": {
      "title": "Task",
      "description": "Individual project task cards and issues",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "project_id": { "type": "number" },
        "column_id": { "type": ["number", "null"] },
        "sprint_id": { "type": ["number", "null"] },
        "task_key": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "priority": { "type": "string" },
        "status": { "type": "string" },
        "story_points": { "type": ["number", "null"] },
        "assignee_id": { "type": ["number", "null"] },
        "assignee_ids": { "type": "array" },
        "reporter_id": { "type": "number" },
        "due_date": { "type": ["string", "null"] },
        "labels": { "type": "array" }
      },
      "required": ["id", "project_id", "title", "task_key"]
    },
    "sprints": {
      "title": "Sprint",
      "description": "Scrum sprint iterations and planning",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "project_id": { "type": "number" },
        "name": { "type": "string" },
        "goal": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "project_id", "name", "status"]
    },
    "comments": {
      "title": "TaskComment",
      "description": "User discussions on tasks",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "task_id": { "type": "number" },
        "user_id": { "type": "number" },
        "content": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "task_id", "user_id", "content"]
    },
    "activity_logs": {
      "title": "ActivityLog",
      "description": "Audit trail of changes made to tasks",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "task_id": { "type": "number" },
        "user_id": { "type": "number" },
        "action": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "task_id", "user_id", "action"]
    },
    "attachments": {
      "title": "TaskAttachment",
      "description": "Files and documents attached to tasks",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "task_id": { "type": "number" },
        "filename": { "type": "string" },
        "uploaded_by": { "type": "number" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "task_id", "filename", "uploaded_by"]
    }
  },
  "firestoreRules": "rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /{document=**} {\n      allow read, write: if true;\n    }\n  }\n}"
}
